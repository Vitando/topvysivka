// Cloudflare Workers – statický web (bez serverového kódu).
// Build command:  node scripts/build-site.mjs   (sestaví dist/)
// Deploy command: npx wrangler deploy           (nahraje dist/ podle tohoto souboru)
// "name" musí odpovídat názvu projektu v Cloudflare.
{
  "name": "topvysivka",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
